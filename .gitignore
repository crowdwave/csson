# Build output (CMake / lexbor clone / old ad-hoc build)
core/build*/
core/obj/
core/csson
core/libcsson.a
*.o
*.a

# Scratch (never committed; recreated on demand)
tmp/

# Node / TypeScript
node_modules/

# Conformance harness scratch
conformance/v1/.verify-out/
conformance/**/.sec*/
conformance/**/.edits*/

# Editor / OS
.DS_Store
*.swp

# WASM build artifacts (regenerated by bindings/wasm/build.sh)
bindings/wasm/build/
bindings/wasm/csson.wasm

# Local maintainer notes (machine-specific gh/git workarounds; not published)
docs/maintainers/

# Binding build artifacts (regenerated)
bindings/javascript/dist/
bindings/javascript/csson.wasm
bindings/python/__pycache__/
bindings/python/*.egg-info/
